{
  "name": "@wirelesspc/desktop",
  "private": true,
  "version": "0.1.4",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "build:win:x64": "tauri build --target x86_64-pc-windows-msvc",
    "build:win:x86": "tauri build --target i686-pc-windows-msvc",
    "build:msstore": "tauri build --bundles msi,nsis --config src-tauri/tauri.microsoftstore.conf.json",
    "build:msstore:updater": "tauri build --config src-tauri/tauri.microsoftstore.conf.json"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-updater": "^2.10.0",
    "@wirelesspc/protocol": "0.1.0",
    "qrcode.react": "^4.2.0",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  }
}
